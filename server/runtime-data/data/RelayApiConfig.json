{
  "statusPagePath": "/relay/info",
  "statusApiPath": "/relay/status",
  "roomsApiPath": "/relay/rooms",
  "adminApiPath": "/relay/admin",
  "enableStatusPage": true,
  "enableStatusApi": true,
  "enableRoomsApi": true,
  "enableAdminApi": false,
  "statusApiRequireWhitelist": true,
  "statusApiIpWhitelist": "127.0.0.1,::1",
  "roomsApiRequireWhitelist": false,
  "roomsApiIpWhitelist": "",
  "adminApiRequireWhitelist": true,
  "adminApiIpWhitelist": "127.0.0.1,::1",
  "adminApiToken": "",
  "corsEnable": true,
  "corsAllowAllOrigins": true,
  "corsAllowOrigins": "*",
  "corsAllowCredentials": false,
  "corsAllowMethods": "GET, POST, OPTIONS",
  "corsAllowHeaders": "Content-Type, Origin, Accept, Authorization, X-Relay-Admin-Token",
  "corsMaxAgeSeconds": 600,
  "statusApiPublicRoomLimit": 20,
  "statusApiCacheMillis": 2000,
  "roomsApiCacheMillis": 3000,
  "apiRateLimitEnabled": true,
  "statusApiRateLimitPerMinute": 120,
  "roomsApiRateLimitPerMinute": 60,
  "adminApiRateLimitPerMinute": 30,
  "roomsApiIncludeClosed": false,
  "roomsApiLimit": 1000
}
